# Hälsa configuration — copy to .env and edit. Never commit .env.

# --- database -----------------------------------------------------------
POSTGRES_DB=halsa
POSTGRES_USER=halsa
POSTGRES_PASSWORD=change-me

# --- django ---------------------------------------------------------------
# long random string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
DJANGO_SECRET_KEY=change-me
# hostnames the app answers on (comma separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,halsa.local,web
# superuser bootstrapped on first start (leave username empty to skip)
DJANGO_SUPERUSER_USERNAME=frank
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=

# --- scheduler ------------------------------------------------------------
# shared secret for GET/POST /scheduler/tick/ (Bearer token).
# empty string disables the endpoint entirely.
SCHEDULER_TOKEN=change-me
# absolute base URL used in reminder-email links
SITE_BASE_URL=http://localhost:8000

# --- deployment (read by docker compose / install.sh) ------------------------
# published app port (put your own TLS reverse proxy in front;
# see docs/DEPLOYMENT.md)
HALSA_HTTP_PORT=8000

# --- email (optional) -------------------------------------------------------
# leave EMAIL_HOST unset to print reminder mails to the web container log
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_FROM=halsa@example.com
# set to 1 ONLY when serving plain http with no TLS proxy in front
# (trusted LAN / benchmark use). Cookies lose the Secure flag.
INSECURE_COOKIES=0
# set to 1 when your reverse proxy forwards X-Forwarded-Proto
HALSA_BEHIND_PROXY=0
# HSTS max-age seconds sent on TLS answers (0 disables)
HALSA_HSTS_SECONDS=31536000
